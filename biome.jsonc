{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build", "!output", "!out", "!public", "!references"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noDuplicateProperties": "off",
        "noDuplicateCustomProperties": "off",
        // https://github.com/biomejs/biome/issues/7223
        "noUnknownAtRules": "off",
        // ui components are safe to use array index key. only storybook demo components are affected
        "noArrayIndexKey": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      "a11y": {
        // Relax for tanstack table components
        "useSemanticElements": "off"
      },
      "nursery": {
        // https://biomejs.dev/linter/rules/use-tailwind-sorted-classes/
        // https://github.com/biomejs/biome/issues/1274#issuecomment-3490774696
        "useTailwindSortedClasses": {
          "fix": "safe",
          "level": "warn"
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:", ":PACKAGE:"],
              ":BLANK_LINE:",
              { "type": true },
              ":BLANK_LINE:",
              "@/types/**",
              ":BLANK_LINE:",
              "@/const/**",
              "@/data/**",
              ":BLANK_LINE:",
              "@/lib/**",
              ":BLANK_LINE:",
              "@/utils/**",
              ":BLANK_LINE:",
              "@/hooks/**",
              ":BLANK_LINE:",
              "@/handlers/**",
              ":BLANK_LINE:",
              "@/components/**",
              ":BLANK_LINE:",
              ["@/app/**", "@/pages/**"],
              "@/**"
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "arrowParentheses": "asNeeded"
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "markdown": {
    // TODO: remove on Biome 2.6.3+; 2.6.2 deletes the blank line between a paragraph and a list (biomejs/biome#12524)
    "formatter": {
      "enabled": false
    },
    // Opt-in: without it Biome formats YAML frontmatter as Markdown and mangles it.
    "parser": {
      "frontmatter": true
    }
  },
  "tailwind": {
    "attributes": ["class", "className", "classList"],
    "mergeFunctions": ["cn", "clsx", "tw"],
    "variantFunctions": ["cva"],
    "stylesheet": "./apps/extension/assets/global.css"
  }
}

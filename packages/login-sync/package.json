{
  "name": "@laplace.live/login-sync",
  "version": "1.0.0",
  "description": "Encrypt, decrypt and version-detect LAPLACE Login Sync payloads",
  "author": "s@laplace.live",
  "license": "GPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://github.com/laplace-live/login-sync/tree/master/packages/login-sync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laplace-live/login-sync.git",
    "directory": "packages/login-sync"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vectors.json": "./vectors.json",
    "./package.json": "./package.json"
  },
  "files": [

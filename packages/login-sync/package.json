    "prepack": "bun run build",
    "smoke": "node scripts/smoke.mjs",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
